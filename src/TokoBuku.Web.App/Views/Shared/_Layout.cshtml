<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TokoBuku Store</title>

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <!-- Storefront Custom Theme CSS -->
    <link href="~/css/storefront.css" rel="stylesheet" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Top Announcement Bar -->
    <div class="py-2 bg-dark text-white text-center small fw-semibold" style="background-color: #042f2e !important;">
        <div class="container d-flex justify-content-between align-items-center">
            <span>🎉 Selamat datang di <strong>TokoBuku Store</strong> — Dapatkan Promo Diskon Buku Pilihan Setiap Hari!</span>
            <div class="d-none d-md-flex align-items-center gap-3">
                <a href="/OrderTracking" class="text-white text-decoration-none hover-underline"><i class="bi bi-truck me-1"></i> Lacak Pesanan</a>
            </div>
        </div>
    </div>

    <!-- Main Storefront Header -->
    <header class="navbar-storefront sticky-top py-3">
        <div class="container d-flex align-items-center justify-content-between gap-3">
            <!-- Brand Logo -->
            <a href="/" class="brand-logo">
                <div class="brand-badge-icon">
                    <i class="bi bi-book-half"></i>
                </div>
                <div>
                    <div>TokoBuku <span class="badge bg-warning text-dark ms-1" style="font-size: 0.65rem;">STORE</span></div>
                </div>
            </a>

            <!-- Search Form -->
            <form action="/Catalog" method="get" class="d-none d-md-flex flex-grow-1 mx-4" style="max-width: 550px;">
                <div class="input-group search-input-group w-100">
                    <input type="text" name="search" class="form-control" placeholder="Cari judul buku, penulis, atau ISBN..." value="@Context.Request.Query["search"]" />
                    <button class="btn btn-search" type="submit">
                        <i class="bi bi-search me-1"></i> Cari
                    </button>
                </div>
            </form>

            <!-- Actions: Catalog, Tracking, Cart -->
            <div class="d-flex align-items-center gap-2">
                <a href="/Catalog" class="btn btn-light rounded-pill px-3 fw-semibold d-none d-sm-inline-flex align-items-center gap-1 border">
                    <i class="bi bi-grid"></i>
                    <span>Katalog</span>
                </a>

                <a href="/OrderTracking" class="btn btn-light rounded-pill px-3 fw-semibold d-inline-flex align-items-center gap-1 border">
                    <i class="bi bi-search"></i>
                    <span class="d-none d-sm-inline">Lacak Pesanan</span>
                </a>

                <!-- Cart Button with Live Badge -->
                <button type="button" class="btn btn-outline-dark rounded-pill px-3 position-relative d-flex align-items-center gap-2 border" data-bs-toggle="offcanvas" data-bs-target="#cartDrawer" onclick="loadCartDrawerContent()">
                    <i class="bi bi-bag-check-fill text-teal" style="color: #0f766e; font-size: 1.15rem;"></i>
                    <span class="fw-bold d-none d-sm-inline">Keranjang</span>
                    <span class="cart-badge badge rounded-pill bg-danger d-none">0</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Offcanvas Cart Drawer (Right Side) -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="cartDrawer" aria-labelledby="cartDrawerLabel" style="width: 380px;">
        <div class="offcanvas-header border-bottom">
            <h5 class="offcanvas-title fw-bold d-flex align-items-center gap-2" id="cartDrawerLabel">
                <i class="bi bi-bag-heart-fill text-teal" style="color: #0f766e;"></i> Keranjang Belanja
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body p-3 d-flex flex-column" id="cartDrawerBody">
            <div id="cartDrawerItemsContainer" class="flex-grow-1 overflow-y-auto pe-1">
                <!-- Dynamically loaded via storefront.js -->
                <div class="text-center py-5 text-muted">
                    <div class="spinner-border text-teal mb-2" role="status"></div>
                    <div>Memuat keranjang...</div>
                </div>
            </div>

            <div class="border-top pt-3 mt-auto">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted fw-semibold">Total Belanja:</span>
                    <span id="cartDrawerTotalAmount" class="fw-bold fs-5 text-dark">Rp 0</span>
                </div>
                <div class="d-grid gap-2">
                    <a href="/Checkout" class="btn btn-accent btn-lg text-dark fw-bold">
                        Lanjut ke Pembayaran <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                    <a href="/Cart" class="btn btn-outline-secondary btn-sm">
                        Lihat Keranjang Lengkap
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Body -->
    <main class="flex-grow-1">
        @if (TempData["Success"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2" role="alert">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                    <div>@TempData["Success"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <div>@TempData["Error"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Modern Storefront Footer -->
    <footer class="storefront-footer">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="brand-badge-icon" style="width: 32px; height: 32px; font-size: 1rem;">
                            <i class="bi bi-book-half"></i>
                        </div>
                        <h5 class="m-0 text-white fw-bold">TokoBuku Store</h5>
                    </div>
                    <p class="small text-secondary mb-3">
                        Toko buku ritel modern dengan ribuan koleksi buku fiksi, komik, pengembangan diri, dan referensi akademik resmi. Belanja mudah, ambil langsung di toko atau kirim ke alamat Anda.
                    </p>
                    <div class="d-flex gap-2">
                        <span class="badge bg-secondary"><i class="bi bi-shield-check me-1"></i> 100% Original</span>
                        <span class="badge bg-secondary"><i class="bi bi-shop me-1"></i> Store Pick-Up</span>
                        <span class="badge bg-secondary"><i class="bi bi-truck me-1"></i> Home Delivery</span>
                    </div>
                </div>

                <div class="col-lg-2 col-md-3 col-6">
                    <h6>Eksplorasi</h6>
                    <ul class="list-unstyled small d-grid gap-2">
                        <li><a href="/Catalog">Semua Buku</a></li>
                        <li><a href="/Catalog?sort=discount_desc">Promo Diskon</a></li>
                        <li><a href="/Catalog?sort=price_asc">Buku Hemat</a></li>
                        <li><a href="/OrderTracking">Lacak Pesanan</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-3 col-6">
                    <h6>Bantuan & Layanan</h6>
                    <ul class="list-unstyled small d-grid gap-2">
                        <li><span class="text-secondary"><i class="bi bi-geo-alt me-1"></i> Jl. Malioboro No. 45, Yogyakarta</span></li>
                        <li><span class="text-secondary"><i class="bi bi-telephone me-1"></i> (0274) 554-321</span></li>
                        <li><span class="text-secondary"><i class="bi bi-clock me-1"></i> Buka Setiap Hari: 08.00 - 21.00</span></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-12">
                    <h6>Metode Pembayaran</h6>
                    <p class="small text-secondary mb-2">Mendukung pembayaran digital instan:</p>
                    <div class="d-flex gap-2 flex-wrap mb-3">
                        <span class="badge bg-light text-dark p-2 border">QRIS</span>
                        <span class="badge bg-light text-dark p-2 border">BCA Virtual Account</span>
                        <span class="badge bg-light text-dark p-2 border">Mandiri Bill</span>
                        <span class="badge bg-light text-dark p-2 border">Tunai di Kasir</span>
                    </div>
                </div>
            </div>

            <div class="border-top border-secondary pt-3 d-flex flex-column flex-sm-row justify-content-between align-items-center small text-secondary">
                <div>&copy; 2026 <strong>TokoBuku Storefront</strong>. Seluruh hak cipta dilindungi.</div>
                <div class="mt-2 mt-sm-0">
                    <span class="text-muted">Portofolio Arsitektur Sistem Ritel Terintegrasi v2</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/storefront.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
