@model TokoBuku.Web.App.ViewModels.OrderTrackingViewModel

@{
    ViewData["Title"] = "Lacak Status Pesanan";
}

<div class="container py-5" style="max-width: 820px;">
    <!-- Title -->
    <div class="text-center mb-4">
        <h3 class="fw-bold"><i class="bi bi-truck text-teal me-2" style="color: #0f766e;"></i>Pelacakan Pesanan Buku</h3>
        <p class="text-muted small">Ketik nomor faktur / invoice pesanan Anda untuk melihat status pemrosesan dan rincian transaksi.</p>
    </div>

    <!-- Search Form -->
    <div class="bg-white rounded-4 border p-4 shadow-sm mb-4">
        <form method="get" action="/OrderTracking">
            <div class="input-group">
                <input type="text" name="invoiceNumber" class="form-control form-control-lg" placeholder="Contoh: J1729938920..." value="@Model.SearchInvoice" required />
                <button type="submit" class="btn btn-bookish px-4 fw-bold">
                    <i class="bi bi-search me-1"></i> Lacak
                </button>
            </div>
        </form>
    </div>

    @if (Model.HasSearched)
    {
        if (Model.IsFound)
        {
            <!-- Result Card -->
            <div class="bg-white rounded-4 border p-4 shadow-sm mb-4">
                <div class="d-flex justify-content-between align-items-center pb-3 border-bottom mb-4">
                    <div>
                        <span class="text-muted small">Nomor Faktur:</span>
                        <h4 class="fw-bold m-0 text-teal" style="color: #0f766e;">@Model.InvoiceNumber</h4>
                    </div>
                    <div>
                        <span class="badge bg-success-subtle text-success fs-6 px-3 py-2 rounded-pill">
                            <i class="bi bi-check-circle-fill me-1"></i> @Model.Status
                        </span>
                    </div>
                </div>

                <!-- Timeline Visual -->
                <div class="py-3 px-2 mb-4 bg-light rounded-3">
                    <div class="row text-center g-2 position-relative">
                        <div class="col-3">
                            <div class="rounded-circle bg-success text-white d-inline-flex align-items-center justify-content-center mb-1" style="width: 36px; height: 36px;">
                                <i class="bi bi-check-lg"></i>
                            </div>
                            <div class="fw-bold small text-dark">Pesanan Dibuat</div>
                            <small class="text-muted d-block" style="font-size: 0.7rem;">@Model.TransactionDate.ToString("HH:mm")</small>
                        </div>
                        <div class="col-3">
                            <div class="rounded-circle bg-success text-white d-inline-flex align-items-center justify-content-center mb-1" style="width: 36px; height: 36px;">
                                <i class="bi bi-credit-card-2-front"></i>
                            </div>
                            <div class="fw-bold small text-dark">Terverifikasi</div>
                            <small class="text-muted d-block" style="font-size: 0.7rem;">Otomatis</small>
                        </div>
                        <div class="col-3">
                            <div class="rounded-circle bg-success text-white d-inline-flex align-items-center justify-content-center mb-1" style="width: 36px; height: 36px;">
                                <i class="bi bi-box-seam"></i>
                            </div>
                            <div class="fw-bold small text-dark">Disiapkan</div>
                            <small class="text-muted d-block" style="font-size: 0.7rem;">Rak Toko</small>
                        </div>
                        <div class="col-3">
                            <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-1" style="width: 36px; height: 36px;">
                                <i class="bi bi-bell-fill"></i>
                            </div>
                            <div class="fw-bold small text-primary">Siap Diambil/Kirim</div>
                            <small class="text-muted d-block" style="font-size: 0.7rem;">Sekarang</small>
                        </div>
                    </div>
                </div>

                <!-- Customer & Items Info -->
                <div class="row g-3 small mb-4">
                    <div class="col-sm-6">
                        <span class="text-muted">Nama Pembeli:</span>
                        <div class="fw-bold">@Model.CustomerName</div>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted">Waktu Transaksi:</span>
                        <div class="fw-bold">@Model.TransactionDate.ToString("dd MMMM yyyy, HH:mm")</div>
                    </div>
                </div>

                <h6 class="fw-bold mb-3 pb-2 border-bottom">Rincian Buku:</h6>
                <div class="d-grid gap-2 mb-3">
                    @foreach (var item in Model.Items)
                    {
                        <div class="d-flex justify-content-between align-items-center p-2 rounded bg-light small">
                            <div>
                                <span class="fw-bold text-dark">@item.Title</span>
                                <span class="text-muted ms-2">x @item.Quantity</span>
                            </div>
                            <div class="fw-semibold">
                                @item.Subtotal.ToString("C0", new System.Globalization.CultureInfo("id-ID"))
                            </div>
                        </div>
                    }
                </div>

                <div class="border-top pt-3 d-flex justify-content-between align-items-baseline">
                    <span class="fw-bold">Total Pembayaran:</span>
                    <span class="fs-4 fw-extrabold text-teal" style="color: #0f766e;">
                        @Model.NetAmount.ToString("C0", new System.Globalization.CultureInfo("id-ID"))
                    </span>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning border-0 p-4 rounded-4 shadow-sm text-center">
                <i class="bi bi-exclamation-circle-fill display-5 text-warning mb-2 d-block"></i>
                <h5 class="fw-bold">Pesanan Tidak Ditemukan</h5>
                <p class="small text-muted mb-0">@Model.ErrorMessage</p>
            </div>
        }
    }
</div>
