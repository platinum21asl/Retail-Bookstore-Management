@model List<TokoBuku.Domain.Entities.Book>
@{
    ViewData["Title"] = "Terminal Kasir POS";
}

<div class="container-fluid px-0">
    <div class="row g-3">
        <!-- LEFT SIDE: Catalog & Book Search (Col-7 / Col-8) -->
        <div class="col-lg-7 col-xl-8">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body p-3">
                    <!-- Search & Filter Bar -->
                    <div class="row g-2 mb-3">
                        <div class="col-md-7">
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                                <input type="text" id="posSearch" class="form-control bg-light border-start-0" placeholder="Ketik judul buku, penulis, atau barcode..." oninput="filterBooks()" />
                            </div>
                        </div>
                        <div class="col-md-5">
                            <select id="posCategoryFilter" class="form-select bg-light" onchange="filterBooks()">
                                <option value="">Semua Kategori</option>
                                @foreach (var cat in (List<CategoryDto>)ViewBag.Categories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Book Grid -->
                    <div class="row g-3" id="bookGrid" style="max-height: calc(100vh - 210px); overflow-y: auto;">
                        @foreach (var book in Model)
                        {
                            var discountedPrice = book.GetDiscountedPrice();
                            <div class="col-sm-6 col-md-4 col-xl-3 book-item"
                                 data-id="@book.Id"
                                 data-title="@book.Title"
                                 data-price="@book.Price"
                                 data-discount="@book.DiscountPercentage"
                                 data-finalprice="@discountedPrice"
                                 data-stock="@book.Stock"
                                 data-category="@book.CategoryId">
                                <div class="card h-100 border shadow-none position-relative product-card @(book.Stock <= 0 ? "opacity-50" : "")" style="cursor: pointer;" onclick="addToCart(@book.Id)">
                                    @if (book.DiscountPercentage > 0)
                                    {
                                        <span class="position-absolute top-0 start-0 m-2 badge bg-danger" style="font-size: 0.7rem; z-index: 2;">
                                            -@book.DiscountPercentage.ToString("0")%
                                        </span>
                                    }

                                    <div class="bg-light text-center rounded-top d-flex align-items-center justify-content-center overflow-hidden" style="height: 120px;">
                                        @if (!string.IsNullOrEmpty(book.CoverImage))
                                        {
                                            var coverSrc = book.CoverImage.StartsWith("/") || book.CoverImage.StartsWith("http") ? book.CoverImage : $"/images/books/{book.CoverImage}";
                                            <img src="@coverSrc" alt="@book.Title" class="w-100 h-100 object-fit-cover" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-book text-muted display-4"></i>
                                        }
                                    </div>

                                    <div class="card-body p-2 d-flex flex-column">
                                        <span class="badge badge-soft-primary mb-1 align-self-start" style="font-size: 0.65rem;">@book.Category?.Name</span>
                                        <div class="fw-bold small text-truncate mb-1" title="@book.Title">@book.Title</div>
                                        <div class="text-muted" style="font-size: 0.72rem;">@book.Author</div>

                                        <div class="mt-auto pt-2">
                                            @if (book.DiscountPercentage > 0)
                                            {
                                                <div class="text-muted text-decoration-line-through" style="font-size: 0.7rem;">Rp @book.Price.ToString("N0")</div>
                                            }
                                            <div class="fw-bold text-primary">Rp @discountedPrice.ToString("N0")</div>
                                            <div class="d-flex justify-content-between align-items-center mt-1">
                                                <small class="badge @(book.Stock > 5 ? "badge-soft-success" : book.Stock > 0 ? "badge-soft-warning" : "badge-soft-danger")" style="font-size: 0.65rem;">
                                                    Stok: @book.Stock
                                                </small>
                                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill" style="font-size: 0.75rem;">
                                                    <i class="bi bi-plus"></i> Tambah
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT SIDE: Cart & Checkout (Col-5 / Col-4) -->
        <div class="col-lg-5 col-xl-4">
            <div class="card h-100 border-0 shadow-sm d-flex flex-column" style="min-height: calc(100vh - 120px);">
                <!-- Cart Header -->
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <div class="fw-bold fs-6">
                        <i class="bi bi-bag-check-fill text-primary me-1"></i> Keranjang Transaksi
                    </div>
                    <button class="btn btn-outline-danger btn-sm py-0 px-2" onclick="clearCart()" title="Kosongkan Keranjang">
                        <i class="bi bi-trash"></i> Reset
                    </button>
                </div>

                <!-- Customer Picker -->
                <div class="p-3 border-bottom bg-light">
                    <label class="form-label small fw-bold mb-1">Pelanggan / Member</label>
                    <select id="posCustomerId" class="form-select form-select-sm">
                        <option value="">Umum (Non-Member)</option>
                        @foreach (var cust in (List<TokoBuku.Domain.Entities.Customer>)ViewBag.Customers)
                        {
                            <option value="@cust.Id">@cust.Name - @cust.CustomerNumber</option>
                        }
                    </select>
                </div>

                <!-- Cart Items List (Scrollable) -->
                <div class="p-3 flex-grow-1 overflow-auto" id="cartContainer" style="max-height: 280px;">
                    <div id="emptyCartMessage" class="text-center py-5 text-muted small">
                        <i class="bi bi-cart-x display-4 d-block mb-2 text-muted"></i>
                        Keranjang masih kosong.<br />Klik buku di sebelah kiri untuk menambah pesanan.
                    </div>
                    <div id="cartItemsList"></div>
                </div>

                <!-- Checkout Totals & Payment Box -->
                <div class="p-3 border-top bg-white mt-auto">
                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>Total Item:</span>
                        <span id="txtTotalItems">0 buku</span>
                    </div>
                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>Subtotal:</span>
                        <span id="txtSubtotal">Rp 0</span>
                    </div>
                    <div class="d-flex justify-content-between small text-danger mb-2">
                        <span>Diskon:</span>
                        <span id="txtDiscount">-Rp 0</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-top border-bottom mb-3">
                        <span class="fw-bold fs-6">Grand Total:</span>
                        <span class="fw-bold fs-4 text-primary" id="txtGrandTotal">Rp 0</span>
                    </div>

                    <!-- Cash Input & Presets -->
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Nominal Pembayaran (Rp)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">Rp</span>
                            <input type="number" id="inputCashPaid" class="form-control fw-bold fs-5 text-end" placeholder="0" oninput="calculateChange()" />
                        </div>
                    </div>

                    <!-- Quick Cash Buttons -->
                    <div class="d-flex gap-1 mb-3">
                        <button type="button" class="btn btn-outline-secondary btn-sm flex-fill py-1 small" onclick="setCashExact()">Uang Pas</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm flex-fill py-1 small" onclick="setCash(50000)">50k</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm flex-fill py-1 small" onclick="setCash(100000)">100k</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm flex-fill py-1 small" onclick="setCash(200000)">200k</button>
                    </div>

                    <!-- Change Display -->
                    <div class="d-flex justify-content-between align-items-center p-2 rounded mb-3" style="background-color: #f1f5f9;">
                        <span class="small fw-semibold">Kembalian:</span>
                        <span class="fw-bold text-dark fs-5" id="txtChange">Rp 0</span>
                    </div>

                    <button type="button" id="btnPay" class="btn btn-primary w-100 py-2 fs-6 fw-bold" onclick="processCheckout()" disabled>
                        <i class="bi bi-shield-check me-1"></i> Bayar &amp; Cetak Struk
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Transaction Success Receipt Modal -->
<div class="modal fade" id="modalReceipt" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-check-circle-fill me-2"></i> Transaksi Berhasil!</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center p-4">
                <div class="mb-3">
                    <span class="text-muted small">Nomor Invoice</span>
                    <h4 class="fw-bold text-primary mb-0" id="receiptSaleId">J123456789</h4>
                </div>

                <div class="card bg-light border-0 p-3 mb-3 text-start small">
                    <div class="d-flex justify-content-between mb-1">
                        <span>Total Belanja:</span>
                        <span class="fw-bold" id="receiptGrandTotal">Rp 0</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span>Uang Diterima:</span>
                        <span id="receiptCashPaid">Rp 0</span>
                    </div>
                    <div class="d-flex justify-content-between border-top pt-1 mt-1 text-success fw-bold">
                        <span>Kembalian:</span>
                        <span id="receiptChange">Rp 0</span>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <a id="btnDownloadReceiptPdf" href="#" target="_blank" class="btn btn-outline-primary">
                        <i class="bi bi-file-earmark-pdf me-1"></i> Cetak / Unduh Struk Thermal PDF
                    </a>
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal" onclick="resetPos()">
                        <i class="bi bi-arrow-repeat me-1"></i> Lanjut Transaksi Berikutnya
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // In-memory reactive Cart State
        let cart = [];
        let grandTotalValue = 0;

        function filterBooks() {
            const query = document.getElementById('posSearch').value.toLowerCase().trim();
            const category = document.getElementById('posCategoryFilter').value;
            const items = document.querySelectorAll('.book-item');

            items.forEach(item => {
                const title = item.getAttribute('data-title').toLowerCase();
                const cat = item.getAttribute('data-category');
                const matchQuery = title.includes(query);
                const matchCategory = !category || cat === category;

                item.style.display = (matchQuery && matchCategory) ? 'block' : 'none';
            });
        }

        function addToCart(bookId) {
            const el = document.querySelector(`.book-item[data-id="${bookId}"]`);
            if (!el) return;

            const stock = parseInt(el.getAttribute('data-stock'));
            if (stock <= 0) {
                Swal.fire({ icon: 'warning', title: 'Stok Habis', text: 'Buku ini tidak memiliki stok tersisa.', timer: 1500 });
                return;
            }

            const existing = cart.find(i => i.bookId === bookId);
            if (existing) {
                if (existing.quantity >= stock) {
                    Swal.fire({ icon: 'warning', title: 'Batas Stok', text: `Maksimal kuantitas adalah stok yang tersedia (${stock}).`, timer: 1500 });
                    return;
                }
                existing.quantity++;
            } else {
                cart.push({
                    bookId: bookId,
                    title: el.getAttribute('data-title'),
                    unitPrice: parseFloat(el.getAttribute('data-price')),
                    discountPercentage: parseFloat(el.getAttribute('data-discount')),
                    finalPrice: parseFloat(el.getAttribute('data-finalprice')),
                    stock: stock,
                    quantity: 1
                });
            }

            renderCart();
        }

        function updateQty(bookId, delta) {
            const item = cart.find(i => i.bookId === bookId);
            if (!item) return;

            const newQty = item.quantity + delta;
            if (newQty <= 0) {
                cart = cart.filter(i => i.bookId !== bookId);
            } else if (newQty > item.stock) {
                Swal.fire({ icon: 'warning', title: 'Batas Stok', text: `Stok hanya tersedia ${item.stock} unit.`, timer: 1500 });
                return;
            } else {
                item.quantity = newQty;
            }

            renderCart();
        }

        function removeItem(bookId) {
            cart = cart.filter(i => i.bookId !== bookId);
            renderCart();
        }

        function clearCart() {
            cart = [];
            renderCart();
        }

        function renderCart() {
            const listEl = document.getElementById('cartItemsList');
            const emptyEl = document.getElementById('emptyCartMessage');
            const btnPay = document.getElementById('btnPay');

            if (cart.length === 0) {
                emptyEl.style.display = 'block';
                listEl.innerHTML = '';
                document.getElementById('txtTotalItems').innerText = '0 buku';
                document.getElementById('txtSubtotal').innerText = 'Rp 0';
                document.getElementById('txtDiscount').innerText = '-Rp 0';
                document.getElementById('txtGrandTotal').innerText = 'Rp 0';
                grandTotalValue = 0;
                btnPay.disabled = true;
                calculateChange();
                return;
            }

            emptyEl.style.display = 'none';

            let html = '';
            let totalItems = 0;
            let subtotal = 0;
            let totalDiscount = 0;

            cart.forEach(item => {
                const itemRaw = item.unitPrice * item.quantity;
                const itemDisc = Math.round(itemRaw * (item.discountPercentage / 100));
                const itemSub = itemRaw - itemDisc;

                totalItems += item.quantity;
                subtotal += itemRaw;
                totalDiscount += itemDisc;

                html += `
                    <div class="d-flex align-items-center justify-content-between p-2 mb-2 rounded bg-light border">
                        <div style="max-width: 50%;">
                            <div class="fw-bold small text-truncate" title="${item.title}">${item.title}</div>
                            <small class="text-muted">Rp ${Number(item.finalPrice).toLocaleString('id-ID')}</small>
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            <button type="button" class="btn btn-sm btn-white border px-2 py-0" onclick="updateQty(${item.bookId}, -1)">-</button>
                            <span class="small fw-bold px-2">${item.quantity}</span>
                            <button type="button" class="btn btn-sm btn-white border px-2 py-0" onclick="updateQty(${item.bookId}, 1)">+</button>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold small">Rp ${Number(itemSub).toLocaleString('id-ID')}</div>
                            <button type="button" class="btn btn-link text-danger p-0 small" onclick="removeItem(${item.bookId})"><i class="bi bi-x-circle"></i></button>
                        </div>
                    </div>
                `;
            });

            listEl.innerHTML = html;
            grandTotalValue = subtotal - totalDiscount;

            document.getElementById('txtTotalItems').innerText = `${totalItems} buku`;
            document.getElementById('txtSubtotal').innerText = 'Rp ' + Number(subtotal).toLocaleString('id-ID');
            document.getElementById('txtDiscount').innerText = '-Rp ' + Number(totalDiscount).toLocaleString('id-ID');
            document.getElementById('txtGrandTotal').innerText = 'Rp ' + Number(grandTotalValue).toLocaleString('id-ID');

            btnPay.disabled = false;
            calculateChange();
        }

        function calculateChange() {
            const cash = parseFloat(document.getElementById('inputCashPaid').value) || 0;
            const change = cash - grandTotalValue;
            const changeEl = document.getElementById('txtChange');

            if (cash >= grandTotalValue && grandTotalValue > 0) {
                changeEl.innerText = 'Rp ' + Number(change).toLocaleString('id-ID');
                changeEl.classList.remove('text-danger');
                changeEl.classList.add('text-success');
            } else if (cash > 0) {
                changeEl.innerText = 'Kurang Rp ' + Number(grandTotalValue - cash).toLocaleString('id-ID');
                changeEl.classList.remove('text-success');
                changeEl.classList.add('text-danger');
            } else {
                changeEl.innerText = 'Rp 0';
                changeEl.classList.remove('text-success', 'text-danger');
            }
        }

        function setCashExact() {
            document.getElementById('inputCashPaid').value = grandTotalValue;
            calculateChange();
        }

        function setCash(amount) {
            document.getElementById('inputCashPaid').value = amount;
            calculateChange();
        }

        async function processCheckout() {
            const cash = parseFloat(document.getElementById('inputCashPaid').value) || 0;
            if (cash < grandTotalValue) {
                Swal.fire({ icon: 'warning', title: 'Pembayaran Kurang', text: 'Nominal uang pembayaran kurang dari grand total belanja.' });
                return;
            }

            const customerId = document.getElementById('posCustomerId').value;

            const payload = {
                customerId: customerId ? parseInt(customerId) : null,
                cashPaid: cash,
                items: cart.map(i => ({ bookId: i.bookId, quantity: i.quantity }))
            };

            const btnPay = document.getElementById('btnPay');
            btnPay.disabled = true;
            btnPay.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Memproses...';

            try {
                const response = await fetch('/Pos/Checkout', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                if (result.success) {
                    // Update modal info
                    document.getElementById('receiptSaleId').innerText = '#' + result.sale.id;
                    document.getElementById('receiptGrandTotal').innerText = 'Rp ' + Number(result.sale.grandTotal).toLocaleString('id-ID');
                    document.getElementById('receiptCashPaid').innerText = 'Rp ' + Number(result.sale.cashPaid).toLocaleString('id-ID');
                    document.getElementById('receiptChange').innerText = 'Rp ' + Number(result.sale.changeReturned).toLocaleString('id-ID');
                    document.getElementById('btnDownloadReceiptPdf').href = '/Sales/ReceiptPdf/' + result.sale.id;

                    const modal = new bootstrap.Modal(document.getElementById('modalReceipt'));
                    modal.show();
                } else {
                    Swal.fire({ icon: 'error', title: 'Gagal', text: result.message || 'Terjadi kesalahan saat transaksi.' });
                }
            } catch (err) {
                Swal.fire({ icon: 'error', title: 'Error', text: err.message });
            } finally {
                btnPay.disabled = false;
                btnPay.innerHTML = '<i class="bi bi-shield-check me-1"></i> Bayar &amp; Cetak Struk';
            }
        }

        function resetPos() {
            clearCart();
            document.getElementById('inputCashPaid').value = '';
            calculateChange();
            window.location.reload(); // Refresh to sync updated stock counts
        }
    </script>
}
