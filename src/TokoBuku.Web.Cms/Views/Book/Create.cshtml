@model TokoBuku.Application.Features.Books.Commands.CreateBookCommand
@{
    ViewData["Title"] = "Tambah Buku Baru";
}

<div class="container-fluid px-0">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 fw-bold"><i class="bi bi-plus-circle text-primary me-2"></i> Formulir Tambah Buku</h6>
                    <a href="/Book" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Kembali</a>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-12">
                                <label class="form-label small fw-bold">Judul Buku</label>
                                <input type="text" name="Title" class="form-control" placeholder="Contoh: Clean Architecture" value="@Model?.Title" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Penulis</label>
                                <input type="text" name="Author" class="form-control" placeholder="Nama penulis / pengarang" value="@Model?.Author" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Kategori</label>
                                <select name="CategoryId" class="form-select" asp-items="ViewBag.Categories" required>
                                    <option value="">-- Pilih Kategori --</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Tahun Terbit</label>
                                <input type="number" name="ReleaseYear" class="form-control" value="@(Model?.ReleaseYear ?? DateTime.UtcNow.Year)" required />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Harga Jual (Rp)</label>
                                <input type="number" name="Price" class="form-control" placeholder="0" value="@Model?.Price" required />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Diskon (%)</label>
                                <input type="number" step="0.5" name="DiscountPercentage" class="form-control" placeholder="0" value="@(Model?.DiscountPercentage ?? 0)" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Stok Awal</label>
                                <input type="number" name="Stock" class="form-control" placeholder="0" value="@(Model?.Stock ?? 0)" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Foto Sampul (Opsional)</label>
                                <input type="file" name="coverFile" class="form-control" accept="image/*" />
                                <small class="text-muted" style="font-size: 0.75rem;">Mendukung format JPG, PNG, WebP.</small>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a href="/Book" class="btn btn-light px-4">Batal</a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-save me-1"></i> Simpan Buku
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
