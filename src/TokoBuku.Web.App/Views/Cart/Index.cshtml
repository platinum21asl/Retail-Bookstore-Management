@model TokoBuku.Web.App.Models.Cart

@{
    ViewData["Title"] = "Keranjang Belanja";
}

<div class="container py-4">
    <div class="d-flex align-items-center gap-2 mb-4">
        <h3 class="fw-bold m-0"><i class="bi bi-bag-check-fill text-teal me-2" style="color: #0f766e;"></i>Keranjang Belanja</h3>
        <span class="badge bg-secondary rounded-pill">@Model.TotalItems item</span>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="text-center py-5 bg-white rounded-4 border shadow-sm">
            <i class="bi bi-cart-x display-1 text-muted mb-3 d-block"></i>
            <h4 class="fw-bold">Keranjang Belanja Anda Kosong</h4>
            <p class="text-muted small mb-4">Anda belum menambahkan buku apapun ke dalam keranjang belanja.</p>
            <a href="/Catalog" class="btn btn-bookish px-4 rounded-pill">
                <i class="bi bi-book me-1"></i> Mulai Cari Buku
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Left: Table of Items -->
            <div class="col-lg-8">
                <div class="bg-white rounded-4 border shadow-sm overflow-hidden">
                    <div class="table-responsive">
                        <table class="table align-middle m-0">
                            <thead class="bg-light">
                                <tr>
                                    <th style="min-width: 250px;">Buku</th>
                                    <th class="text-center" style="width: 140px;">Kuantitas</th>
                                    <th class="text-end" style="width: 130px;">Harga Satuan</th>
                                    <th class="text-end" style="width: 130px;">Subtotal</th>
                                    <th class="text-center" style="width: 60px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    var itemCover = string.IsNullOrEmpty(item.CoverImageUrl)
                                        ? null
                                        : (item.CoverImageUrl.StartsWith("/") || item.CoverImageUrl.StartsWith("http") 
                                            ? item.CoverImageUrl 
                                            : $"/images/books/{item.CoverImageUrl}");
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="rounded-2 overflow-hidden border bg-light d-flex align-items-center justify-content-center text-muted" style="width: 55px; height: 75px; flex-shrink: 0;">
                                                    @if (!string.IsNullOrEmpty(itemCover))
                                                    {
                                                        <img src="@itemCover" alt="@item.Title" class="w-100 h-100 object-fit-cover" />
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-book fs-3"></i>
                                                    }
                                                </div>
                                                <div>
                                                    <a href="/Catalog/Detail/@item.BookId" class="text-dark fw-bold text-decoration-none">
                                                        @item.Title
                                                    </a>
                                                    <div class="small text-muted">@item.Author</div>
                                                    @if (item.DiscountPercent > 0)
                                                    {
                                                        <span class="badge bg-danger rounded-pill" style="font-size: 0.65rem;">
                                                            Diskon @item.DiscountPercent.ToString("0")%
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <form method="post" action="/Cart/UpdateQty" class="d-flex align-items-center justify-content-center gap-1">
                                                <input type="hidden" name="bookId" value="@item.BookId" />
                                                <button type="submit" name="quantity" value="@(item.Quantity - 1)" class="btn btn-sm btn-outline-secondary rounded-circle p-0 d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">-</button>
                                                <span class="px-2 fw-bold">@item.Quantity</span>
                                                <button type="submit" name="quantity" value="@(item.Quantity + 1)" class="btn btn-sm btn-outline-secondary rounded-circle p-0 d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">+</button>
                                            </form>
                                        </td>
                                        <td class="text-end">
                                            <div class="fw-semibold">@item.FinalPrice.ToString("C0", new System.Globalization.CultureInfo("id-ID"))</div>
                                            @if (item.DiscountPercent > 0)
                                            {
                                                <small class="text-muted text-decoration-line-through">@item.UnitPrice.ToString("C0", new System.Globalization.CultureInfo("id-ID"))</small>
                                            }
                                        </td>
                                        <td class="text-end fw-bold text-dark">
                                            @item.Subtotal.ToString("C0", new System.Globalization.CultureInfo("id-ID"))
                                        </td>
                                        <td class="text-center">
                                            <form method="post" action="/Cart/RemoveItem" class="m-0">
                                                <input type="hidden" name="bookId" value="@item.BookId" />
                                                <button type="submit" class="btn btn-sm btn-link text-danger p-0" title="Hapus item">
                                                    <i class="bi bi-trash3 fs-5"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <a href="/Catalog" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                        <i class="bi bi-arrow-left me-1"></i> Tambah Buku Lain
                    </a>
                </div>
            </div>

            <!-- Right: Summary Card -->
            <div class="col-lg-4">
                <div class="bg-white rounded-4 border p-4 shadow-sm">
                    <h5 class="fw-bold mb-3 pb-2 border-bottom">Ringkasan Belanja</h5>

                    <div class="d-flex justify-content-between text-muted small mb-2">
                        <span>Total Kuantitas Buku:</span>
                        <strong class="text-dark">@Model.TotalItems eksemplar</strong>
                    </div>

                    <div class="d-flex justify-content-between text-muted small mb-2">
                        <span>Harga Normal:</span>
                        <span>@Model.TotalOriginalAmount.ToString("C0", new System.Globalization.CultureInfo("id-ID"))</span>
                    </div>

                    @if (Model.TotalDiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between text-danger small mb-2">
                            <span>Hemat Potongan Diskon:</span>
                            <span>-@Model.TotalDiscountAmount.ToString("C0", new System.Globalization.CultureInfo("id-ID"))</span>
                        </div>
                    }

                    <div class="border-top pt-3 mt-3 d-flex justify-content-between align-items-baseline mb-4">
                        <span class="fw-bold fs-6">Total Pembayaran:</span>
                        <span class="fs-4 fw-extrabold text-teal" style="color: #0f766e;">
                            @Model.TotalNetAmount.ToString("C0", new System.Globalization.CultureInfo("id-ID"))
                        </span>
                    </div>

                    <div class="d-grid gap-2">
                        <a href="/Checkout" class="btn btn-accent btn-lg text-dark fw-bold rounded-pill">
                            Lanjut ke Checkout <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
