@model List<TokoBuku.Application.Features.Categories.CategoryDto>
@{
    ViewData["Title"] = "Kategori Buku";
}

<div class="container-fluid px-0">
    <div class="row g-3">
        <!-- Add Category Form -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h6 class="m-0 fw-bold"><i class="bi bi-tag-fill text-primary me-2"></i> Tambah Kategori</h6>
                </div>
                <div class="card-body p-3">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Nama Kategori</label>
                            <input type="text" name="Name" class="form-control" placeholder="Contoh: Sains & Fiksi" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Deskripsi Singkat</label>
                            <textarea name="Description" class="form-control" rows="3" placeholder="Penjelasan kategori..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-plus-lg me-1"></i> Simpan Kategori
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Category List Table -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h6 class="m-0 fw-bold"><i class="bi bi-list-check text-primary me-2"></i> Daftar Kategori</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 50px;">#</th>
                                    <th>Nama Kategori</th>
                                    <th>Deskripsi</th>
                                    <th>Jumlah Buku</th>
                                    <th class="text-end" style="width: 80px;">Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Count == 0)
                                {
                                    <tr><td colspan="5" class="text-center py-4 text-muted">Belum ada kategori.</td></tr>
                                }
                                else
                                {
                                    int no = 1;
                                    foreach (var cat in Model)
                                    {
                                        <tr>
                                            <td class="text-muted small">@(no++)</td>
                                            <td class="fw-bold">@cat.Name</td>
                                            <td class="text-muted small">@(cat.Description ?? "-")</td>
                                            <td>
                                                <span class="badge badge-soft-info">@cat.BookCount buku</span>
                                            </td>
                                            <td class="text-end">
                                                @if (cat.BookCount == 0)
                                                {
                                                    <form asp-action="Delete" asp-route-id="@cat.Id" method="post" onsubmit="return confirm('Hapus kategori ini?');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-outline-danger btn-sm p-1" title="Hapus">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-muted" title="Tidak dapat dihapus karena masih ada buku terkait">Terkunci</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
