@model TokoBuku.Web.App.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout Pesanan";
}

<div class="container py-4">
    <div class="mb-4">
        <h3 class="fw-bold m-0"><i class="bi bi-shield-check text-teal me-2" style="color: #0f766e;"></i>Checkout Pesanan</h3>
        <small class="text-muted">Isi data pemesanan di bawah ini. Anda dapat bertransaksi langsung sebagai Pembeli (Guest) tanpa harus login.</small>
    </div>

    <form method="post" action="/Checkout" id="checkoutForm">
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <!-- Left: Checkout Forms -->
            <div class="col-lg-7">
                <!-- Validation Summary -->
                <div asp-validation-summary="All" class="alert alert-danger border-0 small @(ViewData.ModelState.IsValid ? "d-none" : "")" role="alert"></div>

                <!-- 1. Customer Information (Guest Checkout) -->
                <div class="bg-white rounded-4 border p-4 shadow-sm mb-4">
                    <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                        <span class="badge bg-teal rounded-circle d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; background-color: #0f766e;">1</span>
                        <span>Informasi Pembeli</span>
                    </h5>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="CustomerName" class="form-label small fw-semibold">Nama Lengkap <span class="text-danger">*</span></label>
                            <input asp-for="CustomerName" class="form-control" placeholder="Contoh: Budi Santoso" />
                            <span asp-validation-for="CustomerName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CustomerEmail" class="form-label small fw-semibold">Alamat Email <span class="text-danger">*</span></label>
                            <input asp-for="CustomerEmail" class="form-control" type="email" placeholder="nama@email.com" />
                            <span asp-validation-for="CustomerEmail" class="text-danger small"></span>
                            <div class="form-text" style="font-size: 0.75rem;">Faktur digital akan dikaitkan ke email ini.</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CustomerPhone" class="form-label small fw-semibold">Nomor WhatsApp / HP <span class="text-muted">(Opsional)</span></label>
                            <input asp-for="CustomerPhone" class="form-control" placeholder="081234567890" />
                            <span asp-validation-for="CustomerPhone" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- 2. Fulfillment Method (Store Pick-Up vs Home Delivery) -->
                <div class="bg-white rounded-4 border p-4 shadow-sm mb-4">
                    <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                        <span class="badge bg-teal rounded-circle d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; background-color: #0f766e;">2</span>
                        <span>Opsi Pengambilan / Pengiriman</span>
                    </h5>

                    <div class="row g-3 mb-3">
                        <!-- Option A: Store Pick-Up -->
                        <div class="col-sm-6">
                            <label class="form-check-label w-100 p-3 rounded-3 border h-100 cursor-pointer fulfillment-card" id="cardStorePickUp">
                                <div class="d-flex align-items-start gap-2">
                                    <input class="form-check-input mt-1" type="radio" asp-for="FulfillmentMethod" value="StorePickUp" id="radioPickUp" onchange="toggleFulfillmentUI()" />
                                    <div>
                                        <div class="fw-bold text-dark"><i class="bi bi-shop text-teal me-1" style="color: #0f766e;"></i> Ambil di Toko</div>
                                        <div class="small text-muted mt-1">Gratis Biaya Ongkir. Ambil langsung di kasir toko fisik.</div>
                                        <span class="badge bg-success-subtle text-success mt-2">GRATIS</span>
                                    </div>
                                </div>
                            </label>
                        </div>

                        <!-- Option B: Home Delivery -->
                        <div class="col-sm-6">
                            <label class="form-check-label w-100 p-3 rounded-3 border h-100 cursor-pointer fulfillment-card" id="cardHomeDelivery">
                                <div class="d-flex align-items-start gap-2">
                                    <input class="form-check-input mt-1" type="radio" asp-for="FulfillmentMethod" value="HomeDelivery" id="radioDelivery" onchange="toggleFulfillmentUI()" />
                                    <div>
                                        <div class="fw-bold text-dark"><i class="bi bi-truck text-primary me-1"></i> Kirim ke Alamat</div>
                                        <div class="small text-muted mt-1">Pengiriman kurir paket langsung ke alamat rumah Anda.</div>
                                        <span class="badge bg-primary-subtle text-primary mt-2">Kurir Standar</span>
                                    </div>
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- Address Input (Visible for Home Delivery) -->
                    <div id="shippingAddressContainer" class="d-none pt-2 border-top">
                        <label asp-for="ShippingAddress" class="form-label small fw-semibold">Alamat Lengkap Pengiriman <span class="text-danger">*</span></label>
                        <textarea asp-for="ShippingAddress" class="form-control" rows="3" placeholder="Masukkan nama jalan, nomor rumah, RT/RW, kelurahan, kecamatan, kota, dan kode pos..."></textarea>
                        <span asp-validation-for="ShippingAddress" class="text-danger small"></span>
                    </div>

                    <div class="mt-3">
                        <label asp-for="Notes" class="form-label small fw-semibold">Catatan Tambahan untuk Kasir / Kurir <span class="text-muted">(Opsional)</span></label>
                        <input asp-for="Notes" class="form-control form-control-sm" placeholder="Contoh: Tolong bungkus kertas kado atau hubungi sebelum sampai..." />
                    </div>
                </div>

                <!-- 3. Payment Method -->
                <div class="bg-white rounded-4 border p-4 shadow-sm mb-4">
                    <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                        <span class="badge bg-teal rounded-circle d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; background-color: #0f766e;">3</span>
                        <span>Metode Pembayaran Digital</span>
                    </h5>

                    <div class="d-grid gap-2">
                        <label class="p-3 border rounded-3 d-flex align-items-center justify-content-between cursor-pointer">
                            <div class="d-flex align-items-center gap-3">
                                <input class="form-check-input" type="radio" asp-for="PaymentMethod" value="QRIS" checked />
                                <div>
                                    <div class="fw-bold">QRIS Instant (GoPay, OVO, Dana, BCA Mobile)</div>
                                    <small class="text-muted">Kode QR pembayaran instan verifikasi otomatis</small>
                                </div>
                            </div>
                            <span class="badge bg-light text-dark border">QRIS</span>
                        </label>

                        <label class="p-3 border rounded-3 d-flex align-items-center justify-content-between cursor-pointer">
                            <div class="d-flex align-items-center gap-3">
                                <input class="form-check-input" type="radio" asp-for="PaymentMethod" value="BankBCA" />
                                <div>
                                    <div class="fw-bold">Transfer Virtual Account BCA</div>
                                    <small class="text-muted">Nomor VA instan untuk m-BCA / KlikBCA</small>
                                </div>
                            </div>
                            <span class="badge bg-light text-dark border">BCA</span>
                        </label>

                        <label class="p-3 border rounded-3 d-flex align-items-center justify-content-between cursor-pointer">
                            <div class="d-flex align-items-center gap-3">
                                <input class="form-check-input" type="radio" asp-for="PaymentMethod" value="BankMandiri" />
                                <div>
                                    <div class="fw-bold">Transfer Bank Mandiri (Bill)</div>
                                    <small class="text-muted">Pembayaran Livin by Mandiri</small>
                                </div>
                            </div>
                            <span class="badge bg-light text-dark border">MANDIRI</span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Right: Order Summary Sidebar -->
            <div class="col-lg-5">
                <div class="bg-white rounded-4 border p-4 shadow-sm sticky-top" style="top: 90px; z-index: 10;">
                    <h5 class="fw-bold mb-3 pb-2 border-bottom">Rincian Buku Dipesan</h5>

                    <div class="overflow-y-auto pe-1 mb-3" style="max-height: 280px;">
                        @foreach (var item in Model.Cart.Items)
                        {
                            var itemCover = string.IsNullOrEmpty(item.CoverImageUrl)
                                ? null
                                : (item.CoverImageUrl.StartsWith("/") || item.CoverImageUrl.StartsWith("http") 
                                    ? item.CoverImageUrl 
                                    : $"/images/books/{item.CoverImageUrl}");
                            <div class="d-flex align-items-center gap-3 py-2 border-bottom">
                                <div class="rounded-2 border overflow-hidden bg-light d-flex align-items-center justify-content-center text-muted" style="width: 45px; height: 60px; flex-shrink: 0;">
                                    @if (!string.IsNullOrEmpty(itemCover))
                                    {
                                        <img src="@itemCover" alt="@item.Title" class="w-100 h-100 object-fit-cover" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-book fs-4"></i>
                                    }
                                </div>
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="fw-bold text-truncate small">@item.Title</div>
                                    <div class="text-muted small">@item.Quantity x @item.FinalPrice.ToString("C0", new System.Globalization.CultureInfo("id-ID"))</div>
                                </div>
                                <div class="text-end fw-semibold small">
                                    @item.Subtotal.ToString("C0", new System.Globalization.CultureInfo("id-ID"))
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between text-muted small mb-2">
                        <span>Subtotal Barang:</span>
                        <span>@Model.Cart.TotalOriginalAmount.ToString("C0", new System.Globalization.CultureInfo("id-ID"))</span>
                    </div>

                    @if (Model.Cart.TotalDiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between text-danger small mb-2">
                            <span>Diskon Promosi:</span>
                            <span>-@Model.Cart.TotalDiscountAmount.ToString("C0", new System.Globalization.CultureInfo("id-ID"))</span>
                        </div>
                    }

                    <div class="d-flex justify-content-between text-muted small mb-3">
                        <span>Ongkos Kirim:</span>
                        <span id="shippingCostLabel" class="text-success fw-bold">GRATIS</span>
                    </div>

                    <div class="border-top pt-3 d-flex justify-content-between align-items-baseline mb-4">
                        <span class="fw-bold">Total Pembayaran:</span>
                        <span class="fs-4 fw-extrabold text-teal" style="color: #0f766e;">
                            @Model.Cart.TotalNetAmount.ToString("C0", new System.Globalization.CultureInfo("id-ID"))
                        </span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-accent btn-lg text-dark fw-bold rounded-pill">
                            <i class="bi bi-lock-fill me-1"></i> Konfirmasi & Bayar
                        </button>
                    </div>

                    <div class="text-center mt-3 text-muted" style="font-size: 0.75rem;">
                        <i class="bi bi-shield-lock me-1"></i> Transaksi terenkripsi dan diverifikasi otomatis oleh sistem POS TokoBuku.
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleFulfillmentUI() {
            const isDelivery = document.getElementById('radioDelivery').checked;
            const addressContainer = document.getElementById('shippingAddressContainer');
            const cardPickUp = document.getElementById('cardStorePickUp');
            const cardDelivery = document.getElementById('cardHomeDelivery');
            const shippingLabel = document.getElementById('shippingCostLabel');

            if (isDelivery) {
                addressContainer.classList.remove('d-none');
                cardDelivery.classList.add('border-primary', 'bg-light');
                cardPickUp.classList.remove('border-primary', 'bg-light');
                shippingLabel.textContent = 'Gratis Promo';
            } else {
                addressContainer.classList.add('d-none');
                cardPickUp.classList.add('border-primary', 'bg-light');
                cardDelivery.classList.remove('border-primary', 'bg-light');
                shippingLabel.textContent = 'GRATIS (Ambil Sendiri)';
            }
        }

        document.addEventListener('DOMContentLoaded', toggleFulfillmentUI);
    </script>
}
